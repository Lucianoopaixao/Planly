#  Planly — variáveis de ambiente (dev)
#  Em produção, gere um JWT_SECRET forte: openssl rand -hex 32

# PostgreSQL
POSTGRES_USER=planly
POSTGRES_PASSWORD=planly
POSTGRES_DB=planly

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_DEFAULT_USER=planly
RABBITMQ_DEFAULT_PASS=planly

# JWT (compartilhado entre os serviços)
JWT_SECRET=planly-dev-secret-change-in-prod
